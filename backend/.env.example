MONGO_URL=mongodb://localhost:27017
DB_NAME=district_chronicle
SECRET_KEY=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
COOKIE_NAME=dc_session
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Email notifications (optional). Leave SMTP_HOST blank to disable sending
# entirely — comments/messages will still save normally either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
ADMIN_NOTIFICATION_EMAIL=
